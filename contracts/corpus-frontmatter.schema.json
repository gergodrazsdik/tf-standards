{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gergodrazsdik/tf-review/main/docs/contracts/corpus-frontmatter.schema.json",
  "title": "Corpus frontmatter",
  "description": "Frontmatter of every Markdown doc in the standards corpus. Only accepted docs are retrievable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "status", "applies_to", "severity"],
  "properties": {
    "id": { "type": "string", "pattern": "^(ADR|POL|DES)-[0-9]{3}$" },
    "type": { "enum": ["adr", "policy", "design"] },
    "status": { "enum": ["proposed", "accepted", "superseded", "deprecated"] },
    "superseded_by": { "type": "string", "pattern": "^(ADR|POL|DES)-[0-9]{3}$" },
    "applies_to": {
      "description": "Resource types the doc applies to; \"*\" means every type.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(\\*|[a-z0-9_]+)$" }
    },
    "severity": { "enum": ["low", "medium", "high"] },
    "rego": {
      "description": "Path of the enforcing Rego file, relative to the doc.",
      "type": "string",
      "pattern": "\\.rego$"
    }
  },
  "if": {
    "properties": { "status": { "const": "superseded" } },
    "required": ["status"]
  },
  "then": { "required": ["superseded_by"] },
  "else": { "not": { "required": ["superseded_by"] } }
}
